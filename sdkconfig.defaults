# 이 프로젝트에서 의도적으로 바꾼 설정만 기록한다.
#
# sdkconfig는 `idf.py set-target` 실행 시마다 통째로 재생성되는 산출물이라
# 커밋하지 않는다(.gitignore). 대신 이 파일이 설정의 근거가 되며,
# sdkconfig가 없거나 날아가면 여기서 다시 채워진다.
#
# 규칙: 기본값과 같은 항목은 적지 않는다. 적힌 줄은 전부 "왜 바꿨는지" 설명이 따른다.

# 플래시 4MB
#   칩 실측값. 기본값은 2MB라 그대로 두면 절반을 못 쓴다.
#   부팅 로그 경고: "Detected size(4096k) larger than the size in the
#   binary image header(2048k)"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# PSRAM 활성화
#   이 프로젝트의 전제. 480x272x2byte = 약 255KB인 LCD 프레임버퍼는
#   내부 SRAM(약 390KB)에 둘 수 없다.
CONFIG_SPIRAM=y

# PSRAM 라인 모드 = Octal
#   보드 탑재 칩이 8MB Octal(AP_3v3). Quad로 두면 부팅이 무한 재부팅에 빠진다.
#   상세: docs/TROUBLESHOOTING.md #1
CONFIG_SPIRAM_MODE_OCT=y

# 아래는 기본값이라 적지 않았다. 나중에 바꿀 일이 생기면 그때 이유와 함께 추가한다.
#   CONFIG_SPIRAM_SPEED_40M        기본값. Octal은 80MHz도 선택 가능
#   CONFIG_SPIRAM_MEMTEST=y        기본값. 부팅 시 PSRAM 검사
#   CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
#   CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# mbedTLS 힙을 PSRAM으로 (A/B 측정 중)
#   기본값은 INTERNAL. esp_mem.c:15-19가 MALLOC_CAP_INTERNAL|8BIT을 명시해
#   TLS 핸드셰이크 피크 78,347바이트가 전부 내부 SRAM에서 나갔다.
#   depends on SPIRAM_USE_CAPS_ALLOC || SPIRAM_USE_MALLOC — USE_MALLOC=y로 충족.
#   트레이드오프: 세션 키·평문이 외부 버스로 나간다. 측정이 끝나면 유지 여부를
#   다시 판단한다. docs/STUDY.md §9
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 앱 파티션 1M -> 1500K
#   heap tracing 을 켜기 전 앱 여유가 77,680 바이트(7%)뿐이었다. 먼저 올려두면
#   빌드가 깨졌을 때 "코드가 안 들어가는 것" 과 "측정이 안 되는 것" 이 안 섞인다.
#   OTA 를 쓰지 않으므로 비용 0. 바이너리 크기 자체는 변하지 않아 A/B 비교표도
#   그대로 유효하다.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# heap tracing (standalone)
#   차분법은 총량까지가 한계다. mbedTLS 를 PSRAM 으로 보낸 뒤에도 내부 SRAM 에
#   47,039 바이트가 남았는데, 그 크기 분포를 알아야 래퍼의 임계값을 정할 수 있다.
#   해시맵은 free 때마다 레코드를 선형 탐색하는 것을 막는다(critical section 단축).
#   레코드 버퍼와 해시맵을 모두 PSRAM 에 두는 이유는 계측이 관측 대상인 내부
#   SRAM 을 밀어내면 안 되기 때문이다. docs/STUDY.md §9
CONFIG_HEAP_TRACING_STANDALONE=y
CONFIG_HEAP_TRACE_HASH_MAP=y
CONFIG_HEAP_TRACE_HASH_MAP_IN_EXT_RAM=y

# .bss 를 PSRAM 에 둘 수 있게 한다
#   heap tracing 레코드 버퍼(44바이트 x 1024 = 45,056)를 EXT_RAM_BSS_ATTR 로 내보낸다.
#   ⚠️ 이 심볼은 그것만 하지 않는다 — liblwip.a 의 .bss 전체(14,036)도 같이 PSRAM 으로
#   옮긴다(map: `*liblwip.a:(.bss .bss.*)`). 내부 .bss 가 31,000 -> 17,040 으로 줄어
#   힙 풀이 그만큼 커진다. 즉 이 빌드의 절대값은 A/B 기준선과 비교하면 안 된다.
#   대가: ISR 에서 일어난 할당은 기록되지 않는다(esp_heap_trace.h:70).
#   표적인 TLS 핸드셰이크는 태스크 컨텍스트라 해당 없음.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# heap tracing 콜스택 깊이 2 -> 6
#   기본값 2 로는 호출자를 알 수 없다. alloced_by[0]=heap_caps_malloc_default,
#   [1]=malloc 으로 두 칸이 전부 할당기 껍데기에 먹힌다. 실제 호출자는 [2] 부터다.
#   대가: 레코드가 44 -> 76 바이트 (PSRAM 이므로 내부 SRAM 에 영향 없음).
CONFIG_HEAP_TRACING_STACK_DEPTH=6

# FreeRTOS 트레이스 기능
#   uxTaskGetSystemState() 가 이 심볼에 걸려 있다(tasks.c:2970 의 #if 블록).
#   꺼져 있으면 함수 자체가 컴파일되지 않아 링크 에러가 난다.
#   워터마크 값만 보려면 필요 없다 — uxTaskGetStackHighWaterMark() 는
#   INCLUDE_ 매크로가 항상 1 이라 그냥 된다(FreeRTOSConfig.h:219). 이 심볼이
#   주는 것은 "핸들을 모르는 남의 태스크까지 한 번에 훑는 능력" 이다.
#   Phase 2 에서 내부 SRAM 을 먹는 것의 82% 가 Wi-Fi/lwIP 였으므로 정작
#   보고 싶은 것이 남의 태스크다.
#   ⚠️ 대가: TCB 에 uxTCBNumber/uxTaskNumber 가 붙어 태스크마다 힙이 조금 더
#   나간다. 즉 이 줄을 켜는 순간 A 지점 baseline 이 Phase 2 와 달라진다.
#   켜기 직전/직후를 한 번씩 재서 증가분을 바이트로 확정할 것.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# esp_timer 태스크 스택 3584 -> 2048
#   Phase 3 워터마크 실측: 부하 중 사용량이 484 바이트(14%)로, 3,100 이 놀고 있었다.
#   Kconfig 의 range 최소값이 2048 이라 더 내릴 수 없다(esp_timer/Kconfig:28).
#   남는 마진 1,564 = 관측 사용량의 4.2 배.
#   이 스택은 xTaskCreate 경로라 힙에서 나온다 -> 회수분이 내부 SRAM 여유로 돌아온다.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048

# --- Phase 4: LCD 대시보드 ---
# LVGL 이 자기 정적 풀(LV_MEM_SIZE 기본 64KB)을 쓰지 않게 한다. 그 풀은
# 내부 SRAM 을 통째로 예약해 놓고 우리 계측에는 "할당된 한 덩어리"로만
# 보인다 — 이 프로젝트가 보려는 것이 바로 그 안쪽이다. CLIB 로 두면 LVGL
# 할당이 heap_caps 를 타므로 mem_snapshot 과 heap tracing 에 잡힌다.
CONFIG_LV_USE_CLIB_MALLOC=y
