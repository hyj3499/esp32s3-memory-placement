# 이 프로젝트의 런타임 설정.
#
# menuconfig에 메뉴 하나로 뜨고, 값은 sdkconfig에 저장된다.
# sdkconfig는 .gitignore에 있으므로 여기 넣은 Wi-Fi 비밀번호는 커밋되지 않는다.
#
# 주의: sdkconfig.defaults에는 절대 넣지 말 것. 그 파일은 커밋된다.
#
# 프롬프트와 help는 영문으로 둔다. Windows의 menuconfig(ncurses)에서
# 한글이 깨져 보이는 경우가 있어서다. 설명은 이 주석으로 대신한다.

menu "Multi-heap Manager"

    # Wi-Fi 자격증명.
    # 기본값을 빈 문자열로 둔 것은 의도적이다. "myssid" 같은 더미를 넣어두면
    # 설정을 깜빡했을 때 "연결 실패" 로그만 보고 원인을 한참 찾게 된다.
    config MHM_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            SSID of the access point to connect to.
            Stored in sdkconfig, which is gitignored.

    config MHM_WIFI_PASSWORD
        string "WiFi password"
        default ""
        help
            WPA/WPA2 password. Leave empty for an open network.

    # 무한 재시도를 막는다. AP가 아예 없을 때 로그가 끝없이 흐르면
    # 힙 스냅샷 출력이 묻혀서 Phase 1의 목적을 해친다.
    config MHM_WIFI_MAX_RETRY
        int "Maximum connection retries"
        default 5
        help
            Give up after this many failed attempts.

    # Phase 1 부하의 대상. howsmyssl.com은 IDF 예제가 쓰는 곳으로,
    # 인증서 번들(기본 활성)에 포함된 공개 루트 CA로 검증된다.
    config MHM_LOAD_URL
        string "HTTPS target URL for the load generator"
        default "https://www.howsmyssl.com/a/check"
        help
            Endpoint requested repeatedly to exercise the TLS stack.

    # 요청 간격. 너무 짧으면 상대 서버에 부담을 주고, 너무 길면 단편화가 쌓이는
    # 속도를 보기 어렵다. 2초는 관측용으로 잡은 값이고 근거는 없다 — 실측 후 조정한다.
    config MHM_LOAD_INTERVAL_MS
        int "Delay between HTTPS requests (ms)"
        default 2000
        range 0 600000
        help
            Wait this long after each request completes.

    # 요청 횟수를 축으로 한 스냅샷. 0 이면 끈다.
    config MHM_LOAD_SNAPSHOT_EVERY
        int "Full heap snapshot every N requests (0 = off)"
        default 10
        range 0 1000
        help
            Print the 4-region snapshot after every Nth request.

    # 시간축 주기 출력. 부하가 없으면 같은 숫자만 반복해서 찍힌다.
    config MHM_MONITOR_PERIOD_MS
        int "Heap monitor period (ms)"
        default 5000
        range 100 600000
        help
            One-line heap summary printed at this interval.

    # heap tracing 은 차분법이 못 주는 것 — 할당 하나하나의 크기와 호출자 — 을 준다.
    # 아래 두 항목은 CONFIG_HEAP_TRACING_STANDALONE 이 켜져 있을 때만 뜬다.
    #
    # 레코드 버퍼는 PSRAM(EXT_RAM_BSS_ATTR)에 잡는다. 내부 SRAM 에 두면 지금
    # 재려는 대상을 계측이 밀어낸다. 44바이트 x 1024 = 45,056 바이트(map 실측).
    config MHM_TRACE_RECORDS
        int "Heap trace record buffer size (records)"
        depends on HEAP_TRACING_STANDALONE
        default 1024
        range 64 8192
        help
            Number of heap_trace_record_t entries. 44 bytes each,
            allocated in PSRAM. If the summary reports an overflow,
            raise this value.

    # 첫 핸드셰이크만 추적한다. 45회를 전부 추적하면 레코드가 넘치고,
    # 단편화는 어차피 첫 요청에서 전부 생긴다(STUDY.md §9).
    config MHM_TRACE_AT_REQUEST
        int "Trace the heap during this request number (-1 = off)"
        depends on HEAP_TRACING_STANDALONE
        default 0
        range -1 1000
        help
            Zero-based request index to trace. The trace is started just
            before the request and dumped right after it, once per boot.

endmenu
