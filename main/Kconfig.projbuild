# 이 프로젝트의 런타임 설정.
#
# menuconfig에 메뉴 하나로 뜨고, 값은 sdkconfig에 저장된다.
# sdkconfig는 .gitignore에 있으므로 여기 넣은 Wi-Fi 비밀번호는 커밋되지 않는다.
#
# 주의: sdkconfig.defaults에는 절대 넣지 말 것. 그 파일은 커밋된다.
#
# 프롬프트와 help는 영문으로 둔다. Windows의 menuconfig(ncurses)에서
# 한글이 깨져 보이는 경우가 있어서다. 설명은 이 주석으로 대신한다.

menu "Multi-heap Manager"

    # Wi-Fi 자격증명.
    # 기본값을 빈 문자열로 둔 것은 의도적이다. "myssid" 같은 더미를 넣어두면
    # 설정을 깜빡했을 때 "연결 실패" 로그만 보고 원인을 한참 찾게 된다.
    config MHM_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            SSID of the access point to connect to.
            Stored in sdkconfig, which is gitignored.

    config MHM_WIFI_PASSWORD
        string "WiFi password"
        default ""
        help
            WPA/WPA2 password. Leave empty for an open network.

    # 무한 재시도를 막는다. AP가 아예 없을 때 로그가 끝없이 흐르면
    # 힙 스냅샷 출력이 묻혀서 Phase 1의 목적을 해친다.
    config MHM_WIFI_MAX_RETRY
        int "Maximum connection retries"
        default 5
        help
            Give up after this many failed attempts.

    # Phase 1 부하의 대상. howsmyssl.com은 IDF 예제가 쓰는 곳으로,
    # 인증서 번들(기본 활성)에 포함된 공개 루트 CA로 검증된다.
    config MHM_LOAD_URL
        string "HTTPS target URL for the load generator"
        default "https://www.howsmyssl.com/a/check"
        help
            Endpoint requested repeatedly to exercise the TLS stack.

    # 요청 간격. 너무 짧으면 상대 서버에 부담을 주고, 너무 길면 단편화가 쌓이는
    # 속도를 보기 어렵다. 2초는 관측용으로 잡은 값이고 근거는 없다 — 실측 후 조정한다.
    config MHM_LOAD_INTERVAL_MS
        int "Delay between HTTPS requests (ms)"
        default 2000
        range 0 600000
        help
            Wait this long after each request completes.

    # 요청 횟수를 축으로 한 스냅샷. 0 이면 끈다.
    config MHM_LOAD_SNAPSHOT_EVERY
        int "Full heap snapshot every N requests (0 = off)"
        default 10
        range 0 1000
        help
            Print the 4-region snapshot after every Nth request.

    # 시간축 주기 출력. 부하가 없으면 같은 숫자만 반복해서 찍힌다.
    config MHM_MONITOR_PERIOD_MS
        int "Heap monitor period (ms)"
        default 5000
        range 100 600000
        help
            One-line heap summary printed at this interval.

    # heap tracing 은 차분법이 못 주는 것 — 할당 하나하나의 크기와 호출자 — 을 준다.
    # 아래 두 항목은 CONFIG_HEAP_TRACING_STANDALONE 이 켜져 있을 때만 뜬다.
    #
    # 레코드 버퍼는 PSRAM(EXT_RAM_BSS_ATTR)에 잡는다. 내부 SRAM 에 두면 지금
    # 재려는 대상을 계측이 밀어낸다. 44바이트 x 1024 = 45,056 바이트(map 실측).
    config MHM_TRACE_RECORDS
        int "Heap trace record buffer size (records)"
        depends on HEAP_TRACING_STANDALONE
        default 1024
        range 64 8192
        help
            Number of heap_trace_record_t entries. 44 bytes each,
            allocated in PSRAM. If the summary reports an overflow,
            raise this value.

    # 첫 핸드셰이크만 추적한다. 45회를 전부 추적하면 레코드가 넘치고,
    # 단편화는 어차피 첫 요청에서 전부 생긴다(STUDY.md §9).
    config MHM_TRACE_AT_REQUEST
        int "Trace the heap during this request number (-1 = off)"
        depends on HEAP_TRACING_STANDALONE
        default 0
        range -1 1000
        help
            Zero-based request index to trace. The trace is started just
            before the request and dumped right after it, once per boot.

    # 스택 워터마크 수집용 정적 배열의 칸 수.
    #
    # uxTaskGetSystemState() 는 배열이 태스크 수보다 작으면 아무것도 쓰지 않고
    # 0 을 반환한다 — 에러가 아니라 침묵이다. 부족하면 로그가 그냥 비어 보인다.
    # 여유를 두되, TaskStatus_t x 이 값만큼 .bss 를 먹는다는 것도 기억할 것.
    # 실제 태스크 수는 uxTaskGetNumberOfTasks() 로 로그에 찍힌다.
    config MHM_MAX_TASKS
        int "Max tasks captured by the stack watermark snapshot"
        depends on FREERTOS_USE_TRACE_FACILITY
        default 24
        range 4 64
        help
            Size of the static TaskStatus_t array. If the snapshot reports
            that the buffer was too small, raise this.

    # 스택 표는 태스크 수만큼 줄이 나온다. 매 주기 찍으면 힙 시계열이 묻힌다.
    # 워터마크는 누적 최저치라 자주 찍어서 얻는 것도 없다 — 놓치는 값이 없다.
    config MHM_TASK_STATS_EVERY
        int "Print the stack table every N monitor periods (0 = off)"
        depends on FREERTOS_USE_TRACE_FACILITY
        default 6
        range 0 1000
        help
            The monitor task prints the per-task stack watermark table
            once every N heap lines.

    # ---------------- Phase 4: LCD 대시보드 ----------------

    # 벤더 데모(Arduino_ESP32QSPI.h:9)는 80MHz 로 돌린다. 여기서 40 을 기본으로
    # 두는 것은 첫 점등 때문이다 — 화면이 안 나올 때 "로직이 틀렸나 신호가
    # 죽었나" 를 가르려면 느린 쪽에서 시작하는 편이 낫다. 뜨고 나서 올린다.
    config MHM_LCD_PCLK_MHZ
        int "LCD QSPI clock (MHz)"
        default 40
        range 4 80
        help
            Vendor demo runs at 80 MHz. Start lower for first bring-up.

    # 이 프로젝트에서 가장 설계다운 결정. 드로우 버퍼는 DMA 가 직접 읽으므로
    # 내부 SRAM 이 물리적 강제이고, 내부 SRAM 은 이 프로젝트가 아끼려는 바로
    # 그 자원이다. 즉 대시보드를 키우면 관측 대상이 줄어든다.
    #
    # 480 x N x 2 바이트. 부하 중 내부 연속 블록 실측이 188,416 이므로
    # 20줄(19,200) x 2버퍼 = 38,400 은 그 20% 다.
    config MHM_LCD_BUF_LINES
        int "LVGL draw buffer height (lines)"
        default 20
        range 4 272
        help
            Buffer is 480 * lines * 2 bytes, allocated in internal SRAM
            because DMA cannot reach PSRAM. Two of them if double
            buffering is enabled.

    config MHM_LCD_DOUBLE_BUFFER
        bool "Allocate two draw buffers"
        default y
        help
            Lets LVGL render the next chunk while DMA ships the previous
            one. Costs one more buffer of internal SRAM.

    config MHM_LCD_BACKLIGHT_PCT
        int "Backlight duty (%)"
        default 80
        range 0 100

    # 화면 갱신 주기. 계측 주기(MHM_MONITOR_PERIOD_MS)와 별개다 — 화면은
    # 자주 갱신해도 되지만 heap_caps_get_info() 는 O(n) 이라 값이 비싸다.
    # 그래서 UI 는 캐시된 스냅샷을 읽고, 수집은 모니터 태스크가 한다.
    config MHM_UI_PERIOD_MS
        int "Dashboard refresh period (ms)"
        default 500
        range 50 10000
        help
            LVGL redraw interval. The numbers themselves are collected by
            the monitor task at MHM_MONITOR_PERIOD_MS.

endmenu
